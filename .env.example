# --- Storage (Render disk mounts at /data) ---
DB_PATH=/data/beast.db
GOLD_BACKUP_PATH=data/pinnacle_reference.json
LOG_LEVEL=INFO
# Raw-response captures from the scrapers. Set to /data on Render so they survive redeploys.
BEAST_DATA_DIR=data

# --- Run switch: the code defaults to OFF. Set 1 on Render or no scanner runs. ---
RUN_SCANNER=1

# --- Bankroll and stake (the stake cap of 5% of current bankroll is fixed in code) ---
BANKROLL_START=100000
FLAT_STAKE=5000
# 999 = no daily limit per book
MAX_BETS_PER_BOOK_PER_DAY=999

# --- Odds API: free keys only, comma-separated, rotated. Leave EMPTY until you have real keys. ---
ODDS_API_KEYS=
# Odds API books used only to fill the gold table
API_SOFT_BOOKS=betway,unibet_eu,williamhill,marathonbet,betsson,nordicbet,coolbet,betclic_fr,winamax_fr

# --- Native soft-book scrapers (0 credits) ---
# Only books verified from the server. The others stay in the code but are switched off:
# bet9ja, betano, 1xbet, betking, msport, nairabet, paripesa (geo-blocked or no endpoint yet)
SOFT_BOOKS=sportybet
SPORTYBET_URL=https://www.sportybet.com/api/ng/factsCenter/pcUpcomingEvents
SPORTYBET_PAGES=3
BET9JA_URL=https://sports.bet9ja.com/desktop/feapi/PalimpsestAjax/GetEventsInGroupV2
# JSON mapping league -> Bet9ja group id, e.g. {"nba":"12345"}
BET9JA_GROUPS={}
XBET_HOST=https://1xbet.ng
PARIPESA_HOST=https://paripesa.com
# These four have no default URL, so they stay idle until you set a real endpoint
BETANO_URL=
BETKING_URL=
MSPORT_URL=
NAIRABET_URL=

# --- Telegram (set the real values in Render only, never in git) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
